# Local-only values. Production credentials belong in the host environment, never in this file.
DATABASE_URL=postgresql://daftar_app:daftar-local-only@127.0.0.1:5432/daftar
DATABASE_URL_SUPER=postgresql://daftar:daftar-local-only@127.0.0.1:5432/daftar
WORKER_DATABASE_URL=postgresql://daftar_worker:daftar-local-only@127.0.0.1:5432/daftar
S3_ENDPOINT=http://127.0.0.1:59000
S3_PUBLIC_ENDPOINT=http://127.0.0.1:59000
S3_ACCESS_KEY=daftar
S3_SECRET_KEY=daftar-local-only
S3_BUCKET=statements
S3_REGION=us-east-1
IBAN_ENCRYPTION_KEY=dev-only-iban-key-change-me
# OCR: textract = AWS Textract DetectDocumentText (default for this lab).
# local = Tesseract. Restart the worker after changing. Re-upload to compare.
OCR_PROVIDER=textract
# Windows host Tesseract (only needed when OCR_PROVIDER=local).
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
# Required for textract (never commit real keys — put them only in .env).
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=ap-south-1
# Optional Bedrock model (Nova Lite) if used later for assist — not required for Textract OCR:
# BEDROCK_MODEL_ID=apac.amazon.nova-lite-v1:0
# Optional localstack/moto endpoint for tests:
# AWS_TEXTRACT_ENDPOINT=
WORKER_BASE_URL=http://127.0.0.1:4711
WORKER_TOKEN=dev-worker-token
PDF_PROBE_MIN_CHARS=30
# Local lab: PASS unlocks real-client marking. Do not commit real PDFs. CI/e2e stay FAIL.
PORTAL_SECURITY_STATUS=FAIL
REQUIRE_DOWNLOAD_MFA=true
MFA_DEMO_CODE=000000
MFA_TTL_SECONDS=300
