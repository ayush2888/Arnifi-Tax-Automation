#!/bin/sh
# Blocks a commit when gitleaks is installed and finds a secret.
# Install: https://github.com/gitleaks/gitleaks/releases
# Enable: git config core.hooksPath .githooks
if ! command -v gitleaks >/dev/null 2>&1; then
  echo "gitleaks is not installed; skipping the local secret scan"
  exit 0
fi
gitleaks protect --staged --no-banner --redact --config .gitleaks.toml
